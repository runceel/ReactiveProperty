<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net11.0-windows</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <UseWpf>true</UseWpf>
    <RootNamespace>ReactiveProperty.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!--<PackageReference Include="ChainingAssertion.Bin" Version="1.8.1.3" />-->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Reactive.Testing" />
    <PackageReference Include="Moq" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\ReactiveProperty.Platform.WPF\ReactiveProperty.Platform.WPF.csproj" />
  </ItemGroup>

  <Target Name="ExtractDocumentationExamples" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Documentation\ExtractExamples.ps1&quot; -DocumentationRoot &quot;$(MSBuildProjectDirectory)\..\..\docs&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)\$(IntermediateOutputPath)DocumentationExamples&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)DocumentationExamples\**\*.cs" />
      <Page Include="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)DocumentationExamples\**\*.xaml" />
      <Page Update="@(Page)">
        <Link>DocumentationExamples\%(Page.RecursiveDir)%(Page.Filename)%(Page.Extension)</Link>
      </Page>
      <FileWrites Include="$(IntermediateOutputPath)DocumentationExamples\**\*" />
    </ItemGroup>
  </Target>

</Project>
